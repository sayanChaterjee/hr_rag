# --- LLM: pick one provider ---
# groq   -> free key at https://console.groq.com/keys
# gemini -> free key at https://aistudio.google.com/apikey
# ollama -> no key; run `ollama pull llama3.1:8b` first
LLM_PROVIDER=groq
LLM_API_KEY=
# Optional overrides (defaults depend on LLM_PROVIDER, see app/config.py)
# LLM_MODEL=openai/gpt-oss-120b
# LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Embeddings (local, downloaded once from Hugging Face, ~130 MB) ---
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Retrieval gate: calibrate with `python -m eval.run_eval --retrieval-only` ---
MIN_VECTOR_SCORE=0.52
TOP_K=6

# --- App ---
ADMIN_TOKEN=change-me
HR_CONTACT=hr@example.com
DATA_DIR=data
API_URL=http://localhost:8000
